modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo development server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Local Vercel API"

[[workflows.workflow]]
name = "Expo development server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx expo start --web --port 8081"
waitForPort = 8081

[[workflows.workflow]]
name = "Local Vercel API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run api:dev"
waitForPort = 5000

[userenv]

[userenv.shared]
EXPO_PUBLIC_API_URL = "http://10.0.2.2:5000"
